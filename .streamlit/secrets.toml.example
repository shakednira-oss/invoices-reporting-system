ANTHROPIC_API_KEY = "sk-ant-..."

# תוכן קובץ gmail_credentials.json שלך (הכל בשורה אחת)
GMAIL_CREDENTIALS = '{"web":{"client_id":"...","client_secret":"...","redirect_uris":["https://your-app.streamlit.app/"],"auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}}'

# כתובת האפליקציה שלך ב-Streamlit Cloud
REDIRECT_URI = "https://your-app.streamlit.app/"
